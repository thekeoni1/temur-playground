# Minimal 32-bit x86 kernel config for a v86 guest.
# Sparse fragment: Buildroot runs olddefconfig over this.
# Goal: boot to a busybox shell on ttyS0. No temur inside.

# CPU: plain i686 class (Pentium Pro). No SSE2, no CPU feature
# that a conservative v86 CPU model would lack.
CONFIG_M686=y
# CONFIG_SMP is not set
# CONFIG_HYPERVISOR_GUEST is not set
# CONFIG_PARAVIRT is not set

# Initramfs: this is how the rootfs arrives from v86.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# Userspace entry
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y

# /dev
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Serial console on ttyS0. This is the whole point of the image.
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4

# Filesystems needed by the skeleton
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y

CONFIG_PCI=y

# Trim things a serial-only boot does not need.
# CONFIG_MODULES is not set
# CONFIG_SOUND is not set
# CONFIG_DRM is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set

# P2: networking core ONLY, so that AF_UNIX exists.
# CONFIG_UNIX lives under CONFIG_NET, and crossterm's event reader
# needs a unix socketpair; without it the TUI draws one frame and
# takes its source_failed shutdown path. Neither NET nor UNIX has a
# "default y" in Kconfig, so the sparse fragment above left both off.
# CONFIG_INET is on so a TCP probe to 127.0.0.1 is refused by a
# listener that is not there, rather than rejected by an address
# family that does not exist.
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y

# No network HARDWARE. The guest stays networkless by design on this
# rung; loopback is built in with CONFIG_NET and is all we want.
# CONFIG_NETDEVICES is not set
# CONFIG_IPV6 is not set
# CONFIG_NETFILTER is not set
# CONFIG_BRIDGE is not set
# CONFIG_VLAN_8021Q is not set
# CONFIG_INET_DIAG is not set
# CONFIG_IP_MULTICAST is not set
# CONFIG_IP_ADVANCED_ROUTER is not set
# CONFIG_INET_TUNNEL is not set

# P3a: ONE network interface, ne2k (RTL8029/PCI).
# v86 defaults net_device to {type:"ne2k"} and has emulated it far
# longer than its virtio-net, so this is the better-tested path and it
# costs fewer new symbols: virtio would need VIRTIO_PCI, which P2
# deliberately left off. One driver only, per the brief.
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_8390=y
CONFIG_NE2K_PCI=y

# Still NO CONFIG_PACKET. busybox udhcpc would need raw sockets, but
# the guest is addressed statically instead (192.168.86.100/24 via
# 192.168.86.1), which is fewer moving parts and keeps the raw-socket
# surface out of the guest entirely.

# P3a FIX PASS: unprivileged user namespaces, for temur's key sandbox.
# temur's T18 layer 2 masks every configured key file with /dev/null
# inside an unshare(CLONE_NEWUSER|CLONE_NEWNS) child, so the model cannot
# read a key through the bash tool. Without USER_NS that sandbox cannot
# be built and temur correctly falls back to asking for per-command
# approval on EVERY bash call, which is what the operator hit. USER_NS
# has no depends line in init/Kconfig and defaults to n, so it has to be
# asked for explicitly. MULTIUSER, SYSCTL, PROC_FS and NAMESPACES are
# already on from P1/P2, so this is the only line the fragment gains.
CONFIG_USER_NS=y

# P6 (9p milestone): file transfer between the page and the guest.
# The five symbols the spike proved, and no more. v86 presents an
# in-memory 9p filesystem as a virtio-PCI device, so the chain is
# 9P_FS (the filesystem) -> NET_9P (the protocol) -> NET_9P_VIRTIO
# (the transport) -> VIRTIO + VIRTIO_PCI (the bus it rides).
#
# VIRTIO IS BACK ON AFTER P3a LEFT IT OFF, and that is not a
# contradiction. P3a chose ne2k for the NIC precisely to avoid paying
# for VIRTIO_PCI when nothing else needed it. 9p needs it regardless,
# so the cost is now paid once and the NIC choice stays ne2k: v86 has
# emulated ne2k far longer than its virtio-net, and re-opening a
# settled, working network path is not what this milestone is for.
#
# Cost measured by the spike: +90,112 B of bzImage. The guest mounts
# this at boot from the overlay, tag host9p, 9p2000.L.
CONFIG_9P_FS=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
