# Minimal 32-bit x86 kernel config for a v86 guest.
# Sparse fragment: Buildroot runs olddefconfig over this.
# Goal: boot to a busybox shell on ttyS0. No temur inside.

# CPU: plain i686 class (Pentium Pro). No SSE2, no CPU feature
# that a conservative v86 CPU model would lack.
CONFIG_M686=y
# CONFIG_SMP is not set
# CONFIG_HYPERVISOR_GUEST is not set
# CONFIG_PARAVIRT is not set

# Initramfs: this is how the rootfs arrives from v86.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# Userspace entry
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y

# /dev
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Serial console on ttyS0. This is the whole point of the image.
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4

# Filesystems needed by the skeleton
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y

CONFIG_PCI=y

# Trim things a serial-only boot does not need.
# CONFIG_MODULES is not set
# CONFIG_SOUND is not set
# CONFIG_DRM is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set

# P2: networking core ONLY, so that AF_UNIX exists.
# CONFIG_UNIX lives under CONFIG_NET, and crossterm's event reader
# needs a unix socketpair; without it the TUI draws one frame and
# takes its source_failed shutdown path. Neither NET nor UNIX has a
# "default y" in Kconfig, so the sparse fragment above left both off.
# CONFIG_INET is on so a TCP probe to 127.0.0.1 is refused by a
# listener that is not there, rather than rejected by an address
# family that does not exist.
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y

# No network HARDWARE. The guest stays networkless by design on this
# rung; loopback is built in with CONFIG_NET and is all we want.
# CONFIG_NETDEVICES is not set
# CONFIG_IPV6 is not set
# CONFIG_NETFILTER is not set
# CONFIG_BRIDGE is not set
# CONFIG_VLAN_8021Q is not set
# CONFIG_INET_DIAG is not set
# CONFIG_IP_MULTICAST is not set
# CONFIG_IP_ADVANCED_ROUTER is not set
# CONFIG_INET_TUNNEL is not set
