[
 {
  "name": "write config",
  "cmd": "mkdir -p /root/.config/temur && printf '%s' '{\"provider\":\"openai-compat\",\"max_tokens\":4096,\"openai_compat\":{\"base_url\":\"http://127.0.0.1:8080/v1\",\"model\":\"local\",\"context_window\":8192}}' > /root/.config/temur/config.json && echo config-written"
 },
 {
  "name": "ICRNL is ON, from the overlay, on THIS tier at last",
  "cmd": "stty -g; stty -a 2>/dev/null | tr ' \\t' '\\n\\n' | grep -x -e icrnl -e -icrnl"
 },
 {
  "name": "the 9p share is mounted at /files and this shell is standing in it",
  "cmd": "grep ' /files ' /proc/mounts && pwd && [ \"$(pwd)\" = /files ] && echo SHARE-LANDING-OK"
 },
 {
  "name": "the share is EMPTY and this build has not written to it",
  "cmd": "[ -z \"$(ls -A /files)\" ] && echo SHARE-EMPTY-OK"
 },
 {
  "name": "no key material anywhere in this snapshot",
  "cmd": "ls -la /root/.secrets 2>&1; [ ! -e /root/.secrets ] && [ -z \"$APP_SECRET_FILE\" ] && echo KEYLESS-SNAPSHOT-OK"
 },
 {
  "name": "set tty size",
  "cmd": "stty rows 24 cols 80; echo size-set"
 },
 {
  "name": "settle",
  "cmd": "echo P6-OFFLINE-SNAPSHOT-POINT"
 }
]