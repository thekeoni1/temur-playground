[
  {"name": "write config", "cmd": "mkdir -p /root/.config/temur && printf '%s' '{\"provider\":\"openai-compat\",\"max_tokens\":4096,\"openai_compat\":{\"base_url\":\"http://127.0.0.1:8080/v1\",\"model\":\"local\",\"context_window\":8192}}' > /root/.config/temur/config.json && cat /root/.config/temur/config.json"},
  {"name": "temur doctor with config", "cmd": "temur doctor 2>&1 | head -40"},
  {"name": "tty and term", "cmd": "tty; stty size; echo TERM=$TERM"},
  {"name": "temur TUI draw", "raw": "TERM=xterm temur\n", "waitMs": 12000, "after": "exit\n", "afterMs": 3000},
  {"name": "after quit", "cmd": "echo back-at-shell; echo exit-status-visible"}
]
