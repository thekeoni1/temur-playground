[
 {
  "name": "write config",
  "cmd": "mkdir -p /root/.config/temur && printf '%s' '{\"provider\":\"openai-compat\",\"max_tokens\":4096,\"openai_compat\":{\"base_url\":\"http://127.0.0.1:8080/v1\",\"model\":\"local\",\"context_window\":8192}}' > /root/.config/temur/config.json && echo config-written"
 },
 {
  "name": "set tty size",
  "cmd": "stty rows 24 cols 80; stty -a 2>&1 | head -2"
 },
 {
  "name": "temur TUI draw",
  "raw": "TERM=xterm temur 2>/root/tui.err\n",
  "waitMs": 15000,
  "after": "",
  "afterMs": 4000
 },
 {
  "name": "tui stderr",
  "cmd": "echo STDERR-FOLLOWS; cat /root/tui.err 2>&1 | head -20; echo BACK-AT-SHELL"
 }
]